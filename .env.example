# ==============================================================================
# Qwen 2.1 Turbo + SeedVR2 Studio - Configuration File (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SALADCLOUD DEPLOYMENT CONFIGURATION (Recommended: ~$0.18 - $0.34 / hr)
# ------------------------------------------------------------------------------
# Salad portal API key: https://portal.salad.com/api-keys
SALAD_API_KEY=your_salad_api_key_here

# Salad organization name (found in Salad URL: portal.salad.com/organizations/<org>)
SALAD_ORGANIZATION_NAME=your_organization_name

# Project name (default is usually 'default')
SALAD_PROJECT_NAME=default

# Container group name for deployment
SALAD_CONTAINER_NAME=qwen-turbo-upscaler

# Target GPU class identifier:
# Options:
#   - rtx_a5000 (Recommended: 24GB VRAM, ~$0.18/hr, optimal cost/perf)
#   - rtx_3090_ti (24GB VRAM, ~$0.19/hr)
#   - rtx_4090 (24GB VRAM Ada, ~$0.34/hr, ~2.5s inference)
#   - rtx_5090 (32GB VRAM Blackwell, ~$0.48/hr, ~1.7s inference)
SALAD_GPU_CLASS=rtx_a5000

# ------------------------------------------------------------------------------
# 2. VAST.AI DEPLOYMENT CONFIGURATION (Optional GPU Provider)
# ------------------------------------------------------------------------------
# Vast.ai API Key: https://cloud.vast.ai/account/
VAST_API_KEY=your_vast_api_key_here

# ------------------------------------------------------------------------------
# 3. HUGGING FACE CONFIGURATION (For Space / Hub Integration)
# ------------------------------------------------------------------------------
# Hugging Face User Access Token (Write permissions): https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_write_token_here
HF_SPACE_ID=s3rfdev/qwen_upscaler

# ------------------------------------------------------------------------------
# 4. REMOTE BACKEND URL (For Standalone Web Client / Hugging Face Spaces)
# ------------------------------------------------------------------------------
# Point this to your deployed cloud endpoint (e.g. SaladCloud, Vast.ai, or ngrok)
# If running self-hosted local docker, leave as http://localhost:8000
BACKEND_API_URL=http://localhost:8000
